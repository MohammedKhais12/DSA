class Solution {
public:
    vector<int> decrypt(vector<int>& code, int k) {

        int n = code.size();
        vector<int> ans(n, 0);

        if (k == 0)
            return ans;

        unordered_map<int, int> mp;

        // Store index -> value
        for (int i = 0; i < n; i++) {
            mp[i] = code[i];
        }

        for (int i = 0; i < n; i++) {

            int sum = 0;

            if (k > 0) {

                // Next k elements
                for (int j = 1; j <= k; j++) {
                    int index = (i + j) % n;
                    sum += mp[index];
                }

            } else {

                // Previous -k elements
                for (int j = 1; j <= -k; j++) {
                    int index = (i - j + n) % n;
                    sum += mp[index];
                }
            }

            ans[i] = sum;
        }

        return ans;
    }
};
