class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int i = 0;
        int j = nums.size()-1;
        int first = -1;
        int second= -1;
        
        while(i<=j){
            int mid1 = i+(j-i)/2;
            if(nums[mid1]==target){
                 first = mid1;
                 j = mid1-1;
            }
            else if(nums[mid1]<target){
                i = mid1+1;
            }
            else {
                j = mid1-1;
            }
        }
        i = 0;
        j = nums.size()-1;
        while(i<=j){
            int mid2 = i+(j-i)/2;
            if(nums[mid2]==target){
                 second = mid2;
                 i = mid2+1;
            }
            else if(nums[mid2]<target){
                i = mid2+1;
            }
            else {
                j = mid2-1;
            }
        }
        return {first, second};
    }
};
