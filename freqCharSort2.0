class Solution {
public:
    string frequencySort(string s) {
        unordered_map<char, int> mp;
        for(char c: s){
            mp[c]++;
        }
        sort(s.begin(), s.end(), [&](auto a, auto b){
            if(mp[a]==mp[b]){
                return a<b;
            }
            return mp[a]>mp[b];
        });
        return s;
    }
};
