class Solution {
public:
    int maxProduct(int n) {
        int firstLarge = 0; 
        int secondLarge = 0;

        while(n>0){
            int d = n%10;
            n /= 10;
            if(d>=firstLarge){
                secondLarge = firstLarge;
                firstLarge = d;
            }
            else if(d>secondLarge){
                secondLarge = d;
            }
        }
        return firstLarge * secondLarge;
    }
};
