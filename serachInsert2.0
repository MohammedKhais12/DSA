class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int i = 0; 
        int j = nums.size()-1;
        int x;

        while(i<=j){
            int mid = i+(j-i)/2;
            if(nums[mid]==target){
                return mid;
            }
            else if(nums[mid]>target){
                j = mid-1;
            }
            else if(nums[mid]<target){
                i = mid+1;
            }
        }
        x = j+1;
        return x;
    }
};
