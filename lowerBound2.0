class Solution {
  public:
    int lowerBound(vector<int>& nums, int target) {
        // code here
                int i = 0; 
                int j = nums.size()-1;
                int mn = nums.size();

                while(i<=j){
                    int mid = (i+j)/2;
                    if(nums[mid]>=target){
                        mn = mid;
                        j = mid-1;
                    }
                    else {
                        i = mid+1;
                    }
                }
                return mn;
    }
};
