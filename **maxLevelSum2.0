class Solution {
public:
    int maxLevelSum(Node* root) {
        if (root == NULL) {
            return 0;
        }

        int maxx = INT_MIN;
        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            int n = q.size();
            int sum = 0;

            for (int i = 0; i < n; i++) {
                Node* curr = q.front();
                q.pop();

                sum += curr->data;

                if (curr->left != NULL) {
                    q.push(curr->left);
                }

                if (curr->right != NULL) {
                    q.push(curr->right);
                }
            }

            maxx = max(maxx, sum);
        }

        return maxx;
    }
};
