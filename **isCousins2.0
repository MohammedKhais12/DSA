class Solution {
public:
    bool isCousins(TreeNode* root, int x, int y) {
        if (root == NULL) {
            return false;
        }

        queue<TreeNode*> q;
        q.push(root);

        while (!q.empty()) {
            int n = q.size();
            vector<int> vec;

            TreeNode* parentX = NULL;
            TreeNode* parentY = NULL;

            for (int i = 0; i < n; i++) {
                TreeNode* curr = q.front();
                q.pop();

                if (curr->left != NULL) {
                    q.push(curr->left);
                    vec.push_back(curr->left->val);

                    if (curr->left->val == x)
                        parentX = curr;

                    if (curr->left->val == y)
                        parentY = curr;
                }

                if (curr->right != NULL) {
                    q.push(curr->right);
                    vec.push_back(curr->right->val);

                    if (curr->right->val == x)
                        parentX = curr;

                    if (curr->right->val == y)
                        parentY = curr;
                }
            }

            bool foundX = find(vec.begin(), vec.end(), x) != vec.end();
            bool foundY = find(vec.begin(), vec.end(), y) != vec.end();

            if (foundX && foundY) {
                return parentX != parentY;
            }
        }

        return false;
    }
};
