class Solution {
public:
    string frequencySort(string &s) {
        unordered_map<char, int> mp;

        for(char c : s) {
            mp[c]++;
        }

        vector<char> v;

        for(auto p : mp) {
            v.push_back(p.first);
        }

        sort(v.begin(), v.end(), [&](char a, char b) {
            if(mp[a] == mp[b])
                return a < b;

            return mp[a] < mp[b];
        });

        string ans = "";

        for(char c : v) {
            ans += string(mp[c], c);
        }

        return ans;
    }
};
