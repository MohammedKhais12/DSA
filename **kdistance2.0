/* Structure of Binary Tree Node 
class Node {
public:
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
};*/

class Solution {
  public:
    void distance(Node* root, vector<int> &vec, int k, int l){
        if(root==NULL){
            return;
        }
        if(l==k){
            vec.push_back(root->data);
            return;
        }
        
        distance(root->left, vec, k, l+1);
        distance(root->right, vec, k, l+1);
        
        
    }
    vector<int> kdistance(Node *root, int k) {
        // code here
        vector<int> vec;
        if(k == 0){
            vec.push_back(root->data);
            return vec;
        }
        distance(root, vec, k, 0);
        return vec;
    }
};
