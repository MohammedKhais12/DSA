class Solution {
public:
    int getLevelDiff(Node* root) {
        if (root == NULL) {
            return 0;
        }

        int oddSum = 0;
        int evenSum = 0;
        int flag = 1;

        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            int n = q.size();

            for (int i = 0; i < n; i++) {
                Node* curr = q.front();
                q.pop();

                if (flag == 1) {
                    oddSum += curr->data;
                } else {
                    evenSum += curr->data;
                }

                if (curr->left != NULL) {
                    q.push(curr->left);
                }

                if (curr->right != NULL) {
                    q.push(curr->right);
                }
            }

            flag = 1 - flag;
        }

        return oddSum - evenSum;
    }
};
