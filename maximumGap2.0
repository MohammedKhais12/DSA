class Solution {
public:
    int maximumGap(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int n = nums.size();
        int diff = INT_MIN;
        if(n <2){
            return 0;
        }
        for(int i =0; i<n-1; i++){
            int x = nums[i+1]-nums[i];
            if(diff<x){
                diff = x;
            }
        }
        return diff;
    }
};
