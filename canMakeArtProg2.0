class Solution {
public:
    bool canMakeArithmeticProgression(vector<int>& arr) {
        bool ans = false;
        sort(arr.begin(), arr.end(), greater<int>());
        if(arr.size()<2){
            return ans;
        }
        int diff = arr[0] - arr[1];
        for(int i = 1; i<arr.size()-1; i++){
            if(arr[i]-arr[i+1]!=diff){
                return ans;
            }
        }
        return true;
    }
};
