class Solution {
public:
    bool hasAllCodes(string s, int k) {

        if (s.length() < k)
            return false;

        unordered_set<string> st;

        for (int i = 0; i + k <= s.length(); i++) {
            string sub = s.substr(i, k);
            st.insert(sub);
        }

        return st.size() == (1 << k);
    }
};
