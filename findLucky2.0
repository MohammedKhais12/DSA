class Solution {
public:
    int findLucky(vector<int>& arr) {
        unordered_map<int, int> mp;
        int large = -1;
        for(int x : arr){
            mp[x]++;
        }
        for(auto a : mp){
            if(a.first == a.second){
                large = max(large, a.first);
            }
        }
        return large;
    }
};
