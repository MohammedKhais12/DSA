class Solution {
public:
    int smallestNumber(int n, int t) {
         
        while(true){
            int x = n;
            int product = 1;
            while(x>0){
                int d = x%10;
                x/=10;
                product *= d;
            }
            if(product%t==0){
                return n;
            }
            n++;
        }
        return -1;
    }
};
