class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        long long sum = 0;
        long long maxSum = LLONG_MIN;

        int i = 0;
        int j = 0;

        while (j < nums.size()) {
            sum += nums[j];

            // Window size becomes k
            if (j - i + 1 == k) {
                maxSum = max(maxSum, sum);

                // Slide the window
                sum -= nums[i];
                i++;
            }

            j++;
        }

        return (double)maxSum / k;
    }
};
