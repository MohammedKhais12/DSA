class Solution {
public:
    vector<vector<string>> findMismatchedSegments(string s1, string s2) {
        vector<vector<string>> vec;
        string str1 = "";
        string str2 = "";

        for(int i = 0; i < s1.size(); i++) {
            if(s1[i] == s2[i]) {
                if(str1.size() > 0) {
                    vec.push_back({str1, str2});
                    str1 = "";
                    str2 = "";
                }
            }
            else {
                str1 += s1[i];
                str2 += s2[i];
            }
        }

        if(str1.size() > 0) {
            vec.push_back({str1, str2});
        }

        return vec;
    }
};
