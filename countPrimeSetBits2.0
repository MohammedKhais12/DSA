class Solution {
public:
    int countPrimeSetBits(int left, int right) {
        int ans = 0;

        for(int i = left; i <= right; i++) {
            int num = i;
            int count = 0;

            // Count set bits
            while(num != 0) {
                int k = num % 2;
                count += k;
                num = num >> 1;
            }

            // Check if count is prime
            bool prime = true;

            if(count < 2) {
                prime = false;
            }
            else {
                for(int j = 2; j * j <= count; j++) {
                    if(count % j == 0) {
                        prime = false;
                        break;
                    }
                }
            }

            if(prime) {
                ans++;
            }
        }

        return ans;
    }
};
