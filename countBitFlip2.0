class Solution {
  public:
    int countBitsFlip(int a, int b) {
        // code here
        int x = a^b;
        int count = 0;
        
        while(x!=0){
            int k = x%2;
            if(k == 1){
                count ++;
            }
            x/=2;
        }
        
        return count;
    }
};
