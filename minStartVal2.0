class Solution {
public:
    int minStartValue(vector<int>& nums) {
        int mini = 0;
        int sum = 0;
        for(int i =0; i<nums.size(); i++){
            sum += nums[i];
            mini = min(sum, mini);
        }
        if(mini<0){
            int num = abs(mini) + 1;
            return num;
        }
        return 1;
   }
};
