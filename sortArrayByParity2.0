class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {
        vector<int> vec(nums);
        for(int i=0; i<nums.size(); i++){
            if(vec[i]%2==0){
                vec[i] = -vec[i];
            }
        }
        sort(vec.begin(), vec.end());
        for(int i=0; i<vec.size(); i++){
            if(vec[i]<0){
                vec[i] = abs(vec[i]);
            }
        }
        return vec;
    }
};
