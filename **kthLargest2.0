/* Structure of a Binary Tree Node
class Node {
  public:
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
};*/

class Solution {
  public:
    void inorderReverse(Node* root, int &k, int &ans){
        if(root==NULL){
            return;
        }
        
        inorderReverse(root->right, k, ans);
        if(k==1){
            ans = root->data;
        }
        k--;
        inorderReverse(root->left, k, ans);
    }
    int kthLargest(Node *root, int k) {
        // code here
        int ans;
        inorderReverse(root, k, ans);
        return ans;
    }
};
