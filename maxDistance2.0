class Solution {
public:
    int maxDistance(vector<int>& arr) {
        unordered_map<int, int> first;
        int ans = 0;

        for (int i = 0; i < arr.size(); i++) {

            if (first.find(arr[i]) == first.end()) {
                // First occurrence
                first[arr[i]] = i;
            }
            else {
                // Already occurred
                ans = max(ans, i - first[arr[i]]);
            }
        }

        return ans;
    }
};
