class Solution {
public:
    vector<int> singleNumber(vector<int>& nums) {

        int xorAll = 0;

        // Step 1: XOR all numbers
        for(int num : nums) {
            xorAll = xorAll ^ num;
        }

        // Step 2: Find the rightmost set bit
        int diff = xorAll & (-xorAll);

        int a = 0;
        int b = 0;

        // Step 3: Divide into two groups
        for(int num : nums) {

            if(num & diff) {
                a = a ^ num;
            }
            else {
                b = b ^ num;
            }
        }

        return {a, b};
    }
};
