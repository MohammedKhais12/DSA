class Solution {
public:
    string removeOuterParentheses(string s) {
        string str = "";
        string sub = "";
        int n = 0;
        for(int i=0; i<s.size(); i++){
            sub += s[i];
                if(s[i]=='('){
                    n++;
                }
                else if(s[i]==')'){
                    n--;
                }
                    
            if(n==0){
                str += sub.substr(1, sub.size()-2);
                sub = "";
                n = 0;
            }
        }
        // str += sub.substr(1, sub.size()-2);
        return str;
    }
};
