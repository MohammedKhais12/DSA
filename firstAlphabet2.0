class Solution {
  public:

    string firstAlphabet(string &s) {
        // code here
        string str = "";
        bool check = false;
        str += s[0];
        for(int  i=1; i<s.size(); i++){
            if(check){
                str += s[i];
                check = false;
            }
            else if(s[i]==' '){
                check = true;
            }
        }
        return str;
    }
};
