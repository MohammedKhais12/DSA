class Solution {
public:
    bool canThreePartsEqualSum(vector<int>& arr) {

        int total = 0;

        for(int i = 0; i < arr.size(); i++) {
            total += arr[i];
        }

        // Total must be divisible by 3
        if(total % 3 != 0) {
            return false;
        }

        int pivot = total / 3;
        int count = 0;
        int minTotal = 0;

        for(int i = 0; i < arr.size(); i++) {

            minTotal += arr[i];

            if(minTotal == pivot) {
                count++;
                minTotal = 0;
            }
        }

        return count >= 3;
    }
};
