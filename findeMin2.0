class Solution {
public:
    int findMin(vector<int>& nums) {
        int i = 0;
        int j = nums.size()-1;
        int mn = INT_MAX;

        while(i<=j){
            int mid = i+(j-i)/2;
            if(nums[mid]<nums[j]){
                
                mn = min(mn, nums[mid]);
                j = mid-1;
            }
            else if(nums[i]<=nums[mid]){
                mn = min(mn, nums[i]);
                i = mid+1;
            }
        }
        return mn;
    }
};
